{
  "compilerOptions": {
    "target": "es2016",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",

    "sourceMap": true,

    "allowImportingTsExtensions": true,
    "noImplicitAny": true
  },
  "include": [
    "src/**/*.ts",
  ]
}